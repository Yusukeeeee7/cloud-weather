# 手元でのテスト用（本番のイメージではない）。dev と ml の依存を入れ、リポジトリを /work に載せて使う。
# Windows のアプリケーション制御ポリシーで numpy（pandas）を読み込めない PC でも、
# `ml/` のテスト・mypy・nbmake を実行できるようにするためのもの。
#
#   docker build -f Dockerfile.dev -t cloud-weather-dev .
#   docker run --rm -v "${PWD}:/work" cloud-weather-dev uv run --locked pytest --cov=app --cov=ml
#
# 依存（pyproject.toml・uv.lock）を変えたら、ビルドし直す。
#
# ベースイメージと uv のイメージは、Dockerfile と同じタグと digest で固定する（Dependabot が一緒に上げる）。
FROM ghcr.io/astral-sh/uv:0.13.6@sha256:af22a52f5eafef3d78e551599d405c02df61919d18028f0cea8eda93bc9986d0 AS uv

FROM python:3.15-slim@sha256:94d3426f1def7db4a106a232ac121bfd975393e5dfd40a619b955fae45fe7913

COPY --from=uv /uv /bin/

# LightGBM が読み込む共有ライブラリ（OpenMP）。slim のイメージには入っていない。
# 版は固定しない（DL3008 をこの命令だけ除外）。理由は Dockerfile の同じ命令のコメントと同じ。
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# 仮想環境はイメージの中（/venv）に置き、載せたリポジトリの .venv（Windows 用）には触らない。
ENV UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0 \
    UV_PROJECT_ENVIRONMENT=/venv \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /deps
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-install-project

RUN useradd --system --create-home --uid 10001 appuser && chown -R appuser /venv
# 上で作った appuser の uid。名前でなく数字で指定する（DL3066）。
USER 10001

WORKDIR /work
